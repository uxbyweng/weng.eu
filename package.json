{
    "name": "weng-eu",
    "version": "2.0.0",
    "private": true,
    "type": "module",
    "description": "weng.eu – PHP-Site mit Bun-Build (TypeScript, Sass, Lightning CSS)",
    "scripts": {
        "dev": "bun scripts/dev.ts",
        "build": "bun scripts/build.ts",
        "typecheck": "tsc --noEmit",
        "lint": "biome check .",
        "format": "biome format --write .",
        "check": "bun run typecheck && bun run lint"
    },
    "browserslist": [
        ">0.5%",
        "last 2 versions",
        "not dead"
    ],
    "dependencies": {
        "bootstrap": "^5.3.3"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.6.4",
        "@types/bootstrap": "^5.2.11",
        "@types/bun": "^1.4.4",
        "browserslist": "^4.29.5",
        "lightningcss": "^1.33.0",
        "sass": "^1.107.1",
        "typescript": "^7.0.2"
    }
}
